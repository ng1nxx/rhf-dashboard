# RHF Catering & Snack Box — environment variables
# Copy to `.env.local` and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Round 1 (public website) — optional
# ---------------------------------------------------------------------------

# Canonical site origin, used for metadata, sitemap, and JSON-LD.
# Leave unset locally; on Vercel the deployment URL is detected automatically.
# Set this once a custom domain is live.
NEXT_PUBLIC_SITE_URL="https://rhfcatering.example.com"

# ---------------------------------------------------------------------------
# Round 2 (admin panel)
# ---------------------------------------------------------------------------

# Turso (libSQL). Both come from `turso db show <nama-db>` or the dashboard.
# The application reads these; the Prisma CLI cannot use them — migrations are
# authored against a local SQLite file and applied with `npm run db:push-turso`.
# Example: libsql://rhf-yourorg.aws-ap-southeast-1.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin authentication.
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Bootstrap admin account, used once by the seed script.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset name if uploading directly from the browser.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
