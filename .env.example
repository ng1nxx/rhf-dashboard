# RHF Catering & Snack Box — environment variables
# Copy to `.env.local` and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Round 1 (public website) — optional
# ---------------------------------------------------------------------------

# Canonical site origin, used for metadata, sitemap, and JSON-LD.
# Leave unset locally; on Vercel the deployment URL is detected automatically.
# Set this once a custom domain is live.
NEXT_PUBLIC_SITE_URL="https://rhfcatering.example.com"

# ---------------------------------------------------------------------------
# Round 2 (admin panel) — not yet read by any application code
# ---------------------------------------------------------------------------

# PostgreSQL connection string from Neon or Supabase.
# Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DB?sslmode=require
# Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Direct (non-pooled) connection, required by `prisma migrate` on Neon/Supabase.
DIRECT_URL=

# Admin authentication.
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Bootstrap admin account, used once by the seed script.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset name if uploading directly from the browser.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
