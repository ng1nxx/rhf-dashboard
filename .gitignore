# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries only variable names, no values — whoever clones the repo
# needs it to know what has to be filled in.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — regenerate with `npm run db:generate`
/src/generated/

# Scratch SQLite file that `prisma migrate dev` diffs against. Not the real
# database — the application always talks to Turso. See prisma.config.ts.
/prisma/dev.db
/prisma/dev.db-journal
/prisma/migrations/dev.db*

# One-off database exports taken during the move off Supabase. Real content,
# and the admin password hash, so it stays out of the repo.
/backup/

# documentation — kept on disk, not in the repo. Only the README ships.
# PRD, design notes, and the per-stage specs are working documents; AGENTS.md
# and CLAUDE.md are rewritten locally by tooling and would churn every commit.
*.md
!README.md
/docs/
